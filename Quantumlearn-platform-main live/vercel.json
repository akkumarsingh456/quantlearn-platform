{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "services": {
    "quantumlearn-ai": {
      "root": "artifacts/quantumlearn-ai",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "quantumlearn-ai" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "quantumlearn-ai" }
    }
  ]
}
