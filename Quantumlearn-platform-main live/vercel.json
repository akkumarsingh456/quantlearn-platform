{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "services": {
    "api-server": {
      "root": "Quantumlearn-platform-main live/artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "mockup-sandbox": {
      "root": "Quantumlearn-platform-main live/artifacts/mockup-sandbox",
      "framework": "vite"
    },
    "quantumlearn-ai": {
      "root": "Quantumlearn-platform-main live/artifacts/quantumlearn-ai",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "quantumlearn-ai" }
    }
  ]
}
